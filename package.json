{
  "name": "lapi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "本地个人版 API 网关：聚合上游、请求头改写、预设库、请求头捕获",
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"node --no-warnings --watch server/index.js\" \"vite --config web/vite.config.js\"",
    "start": "node --no-warnings server/index.js",
    "build": "vite --config web/vite.config.js build",
    "extract-presets": "node scripts/extract-cc-switch-presets.mjs",
    "test": "node --test server/test/conversion.test.js server/test/conversion-anthropic-chat.test.js server/test/conversion-anthropic-responses.test.js server/test/conversion-chat-responses.test.js server/test/relay-lib.test.js server/test/usage.test.js"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.477.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
